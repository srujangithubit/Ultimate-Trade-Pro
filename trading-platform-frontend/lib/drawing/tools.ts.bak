// ── Toolbar category groups (matching TradingView's sidebar) ─────────────

export interface ToolGroupDef {
  id: string;
  label: string;
  tools: DrawingToolId[];
  section: 'cursor' | 'lines' | 'forks' | 'gann' | 'fib' | 'patterns' | 'prediction' | 'annotation' | 'shapes' | 'brush' | 'measure' | 'actions';
}

