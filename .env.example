# Shared local-development template.
# Service-specific templates are also available at:
#   backend/.env.example
#   trading-platform-frontend/.env.example
#   mt5-server/.env.example
#
# Never commit real credentials. Copy the relevant template and replace only
# the values required by your environment.

# Backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/trading_platform?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
MT5_INTERNAL_API_KEY="replace-with-a-long-random-service-key"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="http://localhost:3000"
NEXT_PUBLIC_MT5_API_URL="http://localhost:3001"
NEXT_PUBLIC_MT5_WS_URL="ws://localhost:3001/ws/mt5"

# Optional external integrations
FMP_API_KEY=""
POLYGON_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
