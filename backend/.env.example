# =============================================================================
# Trading Platform Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values.

# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/trading_platform?schema=public"

# Authentication (JWT)
JWT_SECRET="CHANGE-THIS-TO-A-STRONG-SECRET"
JWT_REFRESH_SECRET="CHANGE-THIS-TO-A-DIFFERENT-STRONG-SECRET"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# MT5 internal bridge authentication (service-to-service only)
MT5_INTERNAL_API_KEY="SET-A-LONG-RANDOM-INTERNAL-KEY"

# External APIs
POLYGON_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Redis (optional, for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
# Preferred for production; if set, REDIS_HOST/REDIS_PORT are ignored.
REDIS_URL="redis://localhost:6379"

# CORS allow-list (comma-separated origins)
CORS_ORIGIN_ALLOWLIST="https://tradepro.com,http://localhost:3002,http://localhost:3000"

# Distributed replay state TTL in seconds
REPLAY_STATE_TTL=3600

# Global REST and WebSocket rate limit (requests/events per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# AWS S3 (for backups)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BACKUP_BUCKET="trading-platform-backups"

# Monitoring
SENTRY_DSN=""
NEW_RELIC_LICENSE_KEY=""

# OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://tempo:4318/v1/traces"

# Determinism monitor validation mode (set true only for one-shot forced mismatch tests)
DETERMINISM_TEST_MODE=false

# Financial Invariant Monitor
FINANCIAL_INVARIANT_REPORT_URL="http://localhost:3000/internal/observability/financial-invariants"
FINANCIAL_INVARIANT_TRADE_SAMPLE_LIMIT=5000
FINANCIAL_INVARIANT_PNL_TOLERANCE=1.0
FINANCIAL_INVARIANT_LOT_STEP=0.01
FINANCIAL_INVARIANT_LOT_TOLERANCE=0.0000001
FINANCIAL_INVARIANT_MAX_RISK_PERCENT=2.0
FINANCIAL_INVARIANT_TIMESTAMP_FUTURE_TOLERANCE_SECONDS=300
FINANCIAL_INVARIANT_MONITOR_INTERVAL_SECONDS=600
FINANCIAL_INVARIANT_MAX_SAMPLE_IDS=50
FINANCIAL_INVARIANT_MAX_SAMPLE_TIMESTAMP_KEYS=50
FINANCIAL_INVARIANT_MAX_SQL_IDS=25
FINANCIAL_INVARIANT_MAX_SQL_TIMESTAMP_KEYS=15
FINANCIAL_INVARIANT_MAX_PARAMETER_IDS=500
FINANCIAL_INVARIANT_MAX_PARAMETER_TIMESTAMP_KEYS=500
FINANCIAL_INVARIANT_ARTIFACT_SOFT_LIMIT_BYTES=2000000
FINANCIAL_INVARIANT_TRUNCATION_TEST_MODE=false
