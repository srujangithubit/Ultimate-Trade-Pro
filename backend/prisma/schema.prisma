datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String? @map("password_hash")
  displayName String? @map("display_name")
  isVerified Boolean @default(false) @map("is_verified")
  reputationScore Int @default(0) @map("reputation_score")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions UserSession[]
  preferences UserPreferences?
  subscription UserSubscription?
  accounts TradingAccount[]
  playbooks Playbook[]
  trades Trade[]
  backtestingSessions BacktestingSession[]
  communityPosts CommunityPost[]
  postLikes PostLike[]
  postComments PostComment[]
  commentLikes CommentLike[]
  chatMessages ChatMessage[]
  reputationEvents ReputationEvent[]
  savedPosts SavedPost[]
  followers UserFollow[] @relation("Following")
  following UserFollow[] @relation("Followers")
  syncGroups      SyncGroup[]
  masterAccounts  MasterAccount[]
  slaveAccounts   SlaveAccount[]

  @@map("users")
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @map("refresh_token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model UserPreferences {
  userId String @id @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme String @default("dark")
  chartSettings Json? @default("{}") @map("chart_settings")
  notificationSettings Json? @default("{}") @map("notification_settings")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model UserSubscription {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  planTier String @default("free") @map("plan_tier")
  status String @default("active")
  currentPeriodEnd DateTime? @map("current_period_end")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_subscriptions")
}

model TradingAccount {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  broker String?
  accountType String @default("live") @map("account_type")
  currency String @default("USD")
  balance Decimal @default(0) @db.Decimal(18, 2)
  equity Decimal @default(0) @db.Decimal(18, 2)
  accountLogin String? @unique @map("account_login")
  server String?
  apiKeyHash String? @map("api_key_hash")
  lastSeen DateTime? @map("last_seen")
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  backtestingSessions BacktestingSession[]
  trades Trade[]

  @@index([apiKeyHash])
  @@index([userId, active])
  @@map("trading_accounts")
}

model BacktestingSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String? @map("account_id") @db.Uuid
  account TradingAccount? @relation(fields: [accountId], references: [id])
  name String
  status String @default("created")
  configuration Json
  currentTime DateTime? @map("current_time")
  replayIndex Int @default(0) @map("replay_index")
  candleCache Json? @map("candle_cache")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  trades Trade[]
  snapshots SessionSnapshot[]
  chartDrawings ChartDrawing[]

  @@index([userId, status])
  @@map("backtesting_sessions")
}

model SessionSnapshot {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  session BacktestingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  snapshotTime DateTime @default(now()) @map("snapshot_time")
  simulationState Json @map("simulation_state")

  @@map("session_snapshots")
}

model Playbook {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  description String?
  rules Json? @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tags Json? @default("[]")
  
  trades Trade[]

  @@map("playbooks")
}

model Trade {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String? @map("account_id") @db.Uuid
  account TradingAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  playbookId String? @map("playbook_id") @db.Uuid
  playbook Playbook? @relation(fields: [playbookId], references: [id])
  backtestSessionId String? @map("backtest_session_id") @db.Uuid
  backtestSession BacktestingSession? @relation(fields: [backtestSessionId], references: [id], onDelete: Cascade)

  symbol String
  direction String
  setup String?
  entryDate DateTime @map("entry_date")
  exitDate DateTime? @map("exit_date")
  
  entryPrice Decimal @map("entry_price") @db.Decimal(18, 8)
  exitPrice Decimal? @map("exit_price") @db.Decimal(18, 8)
  quantity Decimal @db.Decimal(18, 8)
  
  pnlGross Decimal? @map("pnl_gross") @db.Decimal(18, 2)
  pnlNet Decimal? @map("pnl_net") @db.Decimal(18, 2)
  fees Decimal? @default(0) @db.Decimal(18, 2)
  
  stopLoss Decimal? @map("stop_loss") @db.Decimal(18, 8)
  takeProfit Decimal? @map("take_profit") @db.Decimal(18, 8)
  status String @default("OPEN")
  notes String?
  tags String[]
  customMetrics Json? @default("{}") @map("custom_metrics")

  // MT5 sync fields
  ticket Int?
  magic Int?
  comment String? @map("mt5_comment")
  source String @default("manual")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  screenshots TradeScreenshot[]
  journal TradeJournal?

  @@unique([accountId, ticket])
  @@index([userId, entryDate(sort: Desc)])
  @@index([symbol])
  @@index([accountId, entryDate(sort: Desc)])
  @@map("trades")
}

model TradeJournal {
  id String @id @default(uuid()) @db.Uuid
  tradeId String @unique @map("trade_id") @db.Uuid
  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeIdea String? @map("trade_idea")
  mistakes String?
  emotion String?
  lessonsLearned String? @map("lessons_learned")
  executionScore Int? @map("execution_score")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("trade_journal")
}

model TradeScreenshot {
  id String @id @default(uuid()) @db.Uuid
  tradeId String @map("trade_id") @db.Uuid
  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  url String
  caption String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("trade_screenshots")
}

model MarketDataCandle {
  id         String   @id @default(uuid())
  symbol     String
  resolution String
  time       DateTime
  open       Decimal  @db.Decimal(18,8)
  high       Decimal  @db.Decimal(18,8)
  low        Decimal  @db.Decimal(18,8)
  close      Decimal  @db.Decimal(18,8)
  volume     Decimal  @db.Decimal(18,8)

  @@unique([symbol, resolution, time])
  @@index([symbol, resolution, time])
}

model ChartDrawing {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  session BacktestingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type String
  data Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sessionId])
  @@map("chart_drawings")
}

// ─── Community Models ────────────────────────────────────────────

enum PostType {
  TRADE_IDEA
  ANALYSIS
  FORECAST
  JOURNAL
  DISCUSSION
}

enum Direction {
  BULLISH
  BEARISH
  NEUTRAL
}

enum RoomType {
  GLOBAL
  SYMBOL
  PRIVATE
}

enum ReputationAction {
  POST_CREATED
  POST_LIKED
  COMMENT_CREATED
  POST_SHARED
  FOLLOWED
}

model CommunityPost {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          PostType
  symbol        String
  timeframe     String
  direction     Direction
  entry         Decimal?  @db.Decimal(18, 8)
  sl            Decimal?  @db.Decimal(18, 8)
  tp            Decimal?  @db.Decimal(18, 8)
  description   String    @db.Text
  imageUrl      String?   @map("image_url")
  chartStateId  String?   @unique @map("chart_state_id") @db.Uuid
  chartSnapshot ChartSnapshot?
  likesCount    Int       @default(0) @map("likes_count")
  commentsCount Int       @default(0) @map("comments_count")
  trendingScore Float     @default(0) @map("trending_score")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  likes    PostLike[]
  comments PostComment[]
  saves    SavedPost[]

  @@index([symbol, createdAt])
  @@index([trendingScore(sort: Desc)])
  @@index([userId, createdAt])
  @@map("community_posts")
}

model ChartSnapshot {
  id               String  @id @default(uuid()) @db.Uuid
  postId           String  @unique @map("post_id") @db.Uuid
  post             CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  symbol           String
  timeframe        String
  visibleRangeFrom BigInt  @map("visible_range_from")
  visibleRangeTo   BigInt  @map("visible_range_to")
  drawings         Json    @default("[]")
  indicators       Json    @default("[]")
  priceScaleMode   Int     @default(0) @map("price_scale_mode")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("chart_snapshots")
}

model PostLike {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String @map("post_id") @db.Uuid
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_likes")
}

model PostComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?   @map("parent_id") @db.Uuid
  parent    PostComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentThread")
  content   String    @db.VarChar(2000)
  likesCount Int      @default(0) @map("likes_count")
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")

  commentLikes CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@map("post_comments")
}

model CommentLike {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String @map("comment_id") @db.Uuid
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model ChatRoom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  type      RoomType
  symbol    String?
  createdAt DateTime @default(now()) @map("created_at")

  messages ChatMessage[]

  @@unique([symbol])
  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.VarChar(2000)
  fileUrl   String?  @map("file_url")
  reactions Json     @default("{}")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model ReputationEvent {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      ReputationAction
  points      Int
  referenceId String?          @map("reference_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("reputation_events")
}

model SavedPost {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String @map("post_id") @db.Uuid
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("saved_posts")
}

model UserFollow {
  id          String @id @default(uuid()) @db.Uuid
  followerId  String @map("follower_id") @db.Uuid
  follower    User   @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String @map("following_id") @db.Uuid
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
}

// ─── Trade Sync Models ───────────────────────────────────────────

enum SyncGroupStatus {
  ACTIVE
  PAUSED
  STOPPED
  ERROR
}

enum SlaveStatus {
  ACTIVE
  PAUSED
  STOPPED
  KILLED
  ERROR
}

enum ReplicationEventType {
  TRADE_OPEN
  TRADE_CLOSE
  TRADE_MODIFY
  PARTIAL_CLOSE
  SL_MODIFY
  TP_MODIFY
}

enum ReplicationStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
  KILLED
}

model SyncGroup {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  status            SyncGroupStatus @default(ACTIVE)
  masterAccount     MasterAccount?
  slaveAccounts     SlaveAccount[]
  replicationEvents ReplicationEvent[]
  auditLogs         SyncAuditLog[]
  totalSlaves       Int             @default(0) @map("total_slaves")
  activeSlavesCount Int             @default(0) @map("active_slaves_count")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("sync_groups")
}

model MasterAccount {
  id                     String                 @id @default(uuid()) @db.Uuid
  syncGroupId            String                 @unique @map("sync_group_id") @db.Uuid
  syncGroup              SyncGroup              @relation(fields: [syncGroupId], references: [id], onDelete: Cascade)
  userId                 String                 @map("user_id") @db.Uuid
  user                   User                   @relation(fields: [userId], references: [id])
  accountNumber          String                 @map("account_number")
  brokerName             String                 @map("broker_name")
  serverName             String                 @map("server_name")
  displayName            String                 @map("display_name")
  isConnected            Boolean                @default(false) @map("is_connected")
  lastHeartbeat          DateTime?              @map("last_heartbeat")
  equity                 Decimal                @default(0) @db.Decimal(18, 2)
  balance                Decimal                @default(0) @db.Decimal(18, 2)
  floatingPnL            Decimal                @default(0) @map("floating_pnl") @db.Decimal(18, 2)
  totalReplicatedTrades  Int                    @default(0) @map("total_replicated_trades")
  equitySnapshots        MasterEquitySnapshot[]
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  @@index([userId])
  @@map("master_accounts")
}

model SlaveAccount {
  id                           String                @id @default(uuid()) @db.Uuid
  syncGroupId                  String                @map("sync_group_id") @db.Uuid
  syncGroup                    SyncGroup             @relation(fields: [syncGroupId], references: [id], onDelete: Cascade)
  userId                       String                @map("user_id") @db.Uuid
  user                         User                  @relation(fields: [userId], references: [id])
  accountNumber                String                @map("account_number")
  brokerName                   String                @map("broker_name")
  serverName                   String                @map("server_name")
  displayName                  String                @map("display_name")
  status                       SlaveStatus           @default(ACTIVE)
  isConnected                  Boolean               @default(false) @map("is_connected")
  lastHeartbeat                DateTime?             @map("last_heartbeat")
  equity                       Decimal               @default(0) @db.Decimal(18, 2)
  balance                      Decimal               @default(0) @db.Decimal(18, 2)
  floatingPnL                  Decimal               @default(0) @map("floating_pnl") @db.Decimal(18, 2)
  riskConfig                   Json                  @map("risk_config")
  symbolFilters                String[]              @map("symbol_filters")
  maxDailyDrawdownPct          Decimal               @default(5.00) @map("max_daily_drawdown_pct") @db.Decimal(5, 2)
  currentDailyDrawdownPct      Decimal               @default(0) @map("current_daily_drawdown_pct") @db.Decimal(5, 2)
  killSwitchTriggered          Boolean               @default(false) @map("kill_switch_triggered")
  totalReplicatedTrades        Int                   @default(0) @map("total_replicated_trades")
  totalSuccessfulReplications  Int                   @default(0) @map("total_successful_replications")
  totalFailedReplications      Int                   @default(0) @map("total_failed_replications")
  replicationEvents            ReplicationEvent[]
  equitySnapshots              SlaveEquitySnapshot[]
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")

  @@unique([syncGroupId, accountNumber])
  @@index([syncGroupId, status])
  @@map("slave_accounts")
}

model ReplicationEvent {
  id              String                @id @default(uuid()) @db.Uuid
  syncGroupId     String                @map("sync_group_id") @db.Uuid
  syncGroup       SyncGroup             @relation(fields: [syncGroupId], references: [id])
  masterId        String                @map("master_id")
  slaveId         String                @map("slave_id") @db.Uuid
  slaveAccount    SlaveAccount          @relation(fields: [slaveId], references: [id])
  eventType       ReplicationEventType  @map("event_type")
  status          ReplicationStatus     @default(PENDING)
  masterTicket    String                @map("master_ticket")
  slaveTicket     String?               @map("slave_ticket")
  masterSymbol    String                @map("master_symbol")
  masterVolume    Decimal               @map("master_volume") @db.Decimal(18, 8)
  masterPrice     Decimal               @map("master_price") @db.Decimal(18, 5)
  masterSL        Decimal?              @map("master_sl") @db.Decimal(18, 5)
  masterTP        Decimal?              @map("master_tp") @db.Decimal(18, 5)
  masterSide      String                @map("master_side")
  adjustedVolume  Decimal?              @map("adjusted_volume") @db.Decimal(18, 8)
  skipReason      String?               @map("skip_reason")
  errorMessage    String?               @map("error_message")
  latencyMs       Int?                  @map("latency_ms")
  initiatedAt     DateTime              @default(now()) @map("initiated_at")
  executedAt      DateTime?             @map("executed_at")

  @@index([syncGroupId, initiatedAt(sort: Desc)])
  @@index([slaveId, status])
  @@index([masterTicket])
  @@map("replication_events")
}

model SyncAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  syncGroupId String    @map("sync_group_id") @db.Uuid
  syncGroup   SyncGroup @relation(fields: [syncGroupId], references: [id])
  userId      String    @map("user_id")
  action      String
  details     Json
  performedBy String    @map("performed_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([syncGroupId, createdAt(sort: Desc)])
  @@map("sync_audit_logs")
}

model SlaveEquitySnapshot {
  id           String       @id @default(uuid()) @db.Uuid
  slaveId      String       @map("slave_id") @db.Uuid
  slaveAccount SlaveAccount @relation(fields: [slaveId], references: [id], onDelete: Cascade)
  equity       Decimal      @db.Decimal(18, 2)
  balance      Decimal      @db.Decimal(18, 2)
  floatingPnL  Decimal      @map("floating_pnl") @db.Decimal(18, 2)
  drawdownPct  Decimal      @map("drawdown_pct") @db.Decimal(5, 2)
  snapshotAt   DateTime     @default(now()) @map("snapshot_at")

  @@index([slaveId, snapshotAt(sort: Desc)])
  @@map("slave_equity_snapshots")
}

model MasterEquitySnapshot {
  id            String        @id @default(uuid()) @db.Uuid
  masterId      String        @map("master_id") @db.Uuid
  masterAccount MasterAccount @relation(fields: [masterId], references: [id], onDelete: Cascade)
  equity        Decimal       @db.Decimal(18, 2)
  balance       Decimal       @db.Decimal(18, 2)
  floatingPnL   Decimal       @map("floating_pnl") @db.Decimal(18, 2)
  snapshotAt    DateTime      @default(now()) @map("snapshot_at")

  @@index([masterId, snapshotAt(sort: Desc)])
  @@map("master_equity_snapshots")
}
